{
  "family": "default-triagem-app",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "4096",
  "executionRoleArn": "arn:aws:iam::391301918120:role/LabRole",
  "taskRoleArn": "arn:aws:iam::391301918120:role/LabRole",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "Main",
      "image": "391301918120.dkr.ecr.us-east-1.amazonaws.com/triagem-app:latest",
      "cpu": 2048,
      "memoryReservation": 4096,
      "essential": true,
      "portMappings": [
        {
          "name": "main-8000-tcp",
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "MODEL_PATH", "value": "/app/models/classifier.pkl" },
        { "name": "METADATA_PATH", "value": "/app/models/metadata.json" },
        { "name": "MODEL_BACKEND", "value": "onnx-int8" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/aws/ecs/default/triagem-app-29fb",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
