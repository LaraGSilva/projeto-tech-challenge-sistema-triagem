# =============================================================================
# Dockerfile.airflow — imagem do Airflow para a pipeline de treino ML
#
# Estende a imagem oficial do Airflow e instala apenas as libs extras que a
# DAG (dags/ml_pipeline_dag.py) importa. O código do projeto NÃO é copiado para
# a imagem — o docker-compose monta o repositório em /opt/airflow/project e
# expõe via PYTHONPATH.
#
#   docker compose build
#   docker compose up airflow-init      # 1ª vez: cria o metadata DB + usuário
#   docker compose up -d
# =============================================================================
ARG AIRFLOW_VERSION=2.10.5
ARG PYTHON_VERSION=3.11

FROM apache/airflow:${AIRFLOW_VERSION}-python${PYTHON_VERSION} AS runtime

# Instala como usuário airflow (obrigatório na imagem oficial)
COPY requirements-airflow.txt /requirements-airflow.txt
RUN pip install --no-cache-dir -r /requirements-airflow.txt

LABEL maintainer="ml_team" \
      project="medical-abstracts-classification"
